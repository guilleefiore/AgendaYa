{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "incremental": true,
    "noEmit": false,
    "outDir": ".next/types/cypress",
    "tsBuildInfoFile": ".next/cache/tsconfig.cypress.tsbuildinfo",
    "types": ["cypress", "node"]
  },
  "include": ["src/tests/**/*.cy.ts", "src/tests/**/*.cy.tsx"],
  "exclude": ["node_modules"]
}
